+fn fixture_m42_upgrade_accept(repository: &Path, m42_binary: &Path) -> Result<(), String> {
+    doctor(repository)?;
+    let repository = canonical_repository(repository)?;
+    let m42_binary = m42_binary
+        .canonicalize()
+        .map_err(|error| format!("cannot canonicalize M42 binary: {error}"))?;
+    require_hash(&m42_binary, M42_BINARY_SHA256, "M42 release binary")?;
+    let protected = [
+        "test/fixtures/m31-lock/canonical-golden.tsv",
+        "test/fixtures/m31-lock/model-cases.tsv",
+        "RUST_CONCURRENT_HISTORY_REGRESSION_M42.adoc",
+    ];
+    let protected_before = protected
+        .iter()
+        .map(|path| hash_file(&repository.join(path)))
+        .collect::<Result<Vec<_>, _>>()?;
+
+    let root = repository.join(".leanbun-dev-rust/release-fixture/m48-m42-upgrade-acceptance");
+    if root.exists() {
+        return Err("M48 M42 upgrade acceptance root already exists".to_owned());
+    }
+    fs::create_dir_all(&root)
+        .map_err(|error| format!("cannot create M48 upgrade acceptance root: {error}"))?;
+    let cleanup = Cleanup(root.clone());
+    let old_version = root.join("versions").join(M42_RELEASE_VERSION);
+    fs::create_dir_all(&old_version)
+        .map_err(|error| format!("cannot seed M42 version directory: {error}"))?;
+    fs::copy(&m42_binary, old_version.join("leanbun"))
+        .map_err(|error| format!("cannot seed exact M42 binary: {error}"))?;
+    fs::write(old_version.join("config.v1"), M42_RELEASE_CONFIG)
+        .map_err(|error| format!("cannot seed M42 release config: {error}"))?;
+    sync_file(&old_version.join("leanbun"))?;
+    sync_file(&old_version.join("config.v1"))?;
+    sync_directory(&old_version)?;
+    atomic_write(&root, "active", &format!("{M42_RELEASE_VERSION}\n"))?;
+
+    install_release(&repository, &root, false)?;
+    if read_record(&root.join("active"))? != RELEASE_VERSION
+        || read_record(&root.join("previous"))? != M42_RELEASE_VERSION
+        || hash_file(&old_version.join("leanbun"))?.to_string() != M42_BINARY_SHA256
+    {
+        return Err("M48 upgrade did not retain the exact M42 release".to_owned());
+    }
+    rollback_install(&repository, &root)?;
+    if read_record(&root.join("active"))? != M42_RELEASE_VERSION
+        || read_record(&root.join("previous"))? != RELEASE_VERSION
+        || !root
+            .join("versions")
+            .join(RELEASE_VERSION)
+            .join("leanbun")
+            .is_file()
+    {
+        return Err("M48 rollback did not restore M42 while retaining M48".to_owned());
+    }
+    let old_output = Command::new(old_version.join("leanbun"))
+        .arg("version")
+        .output()
+        .map_err(|error| format!("cannot execute restored M42 binary: {error}"))?;
+    let old_stdout = String::from_utf8(old_output.stdout)
+        .map_err(|_| "restored M42 version output is not UTF-8".to_owned())?;
+    if !old_output.status.success() || old_stdout.lines().next() != Some("leanbun 0.11.0-m42-dev") {
+        return Err("restored M42 binary did not execute as 0.11.0-m42-dev".to_owned());
+    }
+    for (path, before) in protected.iter().zip(protected_before) {
+        if hash_file(&repository.join(path))? != before {
+            return Err(format!(
+                "upgrade or rollback rewrote retained evidence: {path}"
+            ));
+        }
+    }
+    println!("m42-upgrade-acceptance-status=passed");
+    println!("source-version={M42_RELEASE_VERSION}");
+    println!("source-binary-sha256={M42_BINARY_SHA256}");
+    println!("upgrade-version={RELEASE_VERSION}");
+    println!("rollback-active-version={M42_RELEASE_VERSION}");
+    println!("restored-m42-execution=passed");
+    println!("retained-evidence=unchanged");
+    drop(cleanup);
+    Ok(())
+}
