+fn run_arguments(
+    mut arguments: impl Iterator<Item = std::ffi::OsString>,
+) -> Result<(PathBuf, PathBuf, Vec<String>), String> {
+    let repository = arguments
+        .next()
+        .ok_or_else(|| "run requires repository and managed project selector".to_owned())?;
+    let query = arguments
+        .next()
+        .ok_or_else(|| "run requires repository and managed project selector".to_owned())?;
+    let Some(delimiter) = arguments.next() else {
+        return Ok((PathBuf::from(repository), PathBuf::from(query), Vec::new()));
+    };
+    if delimiter != OsStr::new("--") {
+        return Err("run program arguments require the exact -- delimiter".to_owned());
+    }
+    let mut program_arguments = Vec::new();
+    for argument in arguments {
+        program_arguments.push(
+            argument
+                .into_string()
+                .map_err(|_| "run program arguments must be UTF-8".to_owned())?,
+        );
+    }
+    Ok((
+        PathBuf::from(repository),
+        PathBuf::from(query),
+        program_arguments,
+    ))
+}
