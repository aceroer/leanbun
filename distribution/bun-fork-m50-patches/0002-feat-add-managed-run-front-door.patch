+fn run_project(repository: &Path, query: &Path, arguments: &[String]) -> Result<u8, String> {
+    let executable = env::current_exe()
+        .map_err(|error| format!("cannot identify managed run supervisor: {error}"))?;
+    let result = run_managed_program_front_door_v1(repository, query, executable, arguments)
+        .map_err(managed_error)?;
+    std::io::stdout()
+        .write_all(&result.program.stdout)
+        .map_err(|error| format!("cannot emit managed program stdout: {error}"))?;
+    std::io::stdout()
+        .flush()
+        .map_err(|error| format!("cannot flush managed program stdout: {error}"))?;
+    std::io::stderr()
+        .write_all(&result.program.stderr)
+        .map_err(|error| format!("cannot emit managed program stderr: {error}"))?;
+    std::io::stderr()
+        .flush()
+        .map_err(|error| format!("cannot flush managed program stderr: {error}"))?;
+    Ok(result.program.exit_code)
+}
