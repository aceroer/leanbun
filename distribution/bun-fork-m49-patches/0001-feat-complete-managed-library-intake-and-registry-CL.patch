+fn manage_list(repository: &Path, json: bool) -> Result<bool, String> {
+    validate_doctor(repository)?;
+    let report = read_managed_registry_v1(repository).map_err(managed_error)?;
+    if json {
+        println!("{}", report.to_canonical_json());
+    } else {
+        println!("PROJECT ID\tSTATUS\tPACKAGES\tTARGET\tPROJECT");
+        for status in &report.projects {
+            print_managed_library_row(status);
+        }
+    }
+    Ok(report.all_healthy())
+}
+
+fn manage_status(repository: &Path, query: &Path, json: bool) -> Result<bool, String> {
+    validate_doctor(repository)?;
+    let status = managed_library_status_v1(repository, query).map_err(managed_error)?;
+    if json {
+        println!("{}", status.to_canonical_json());
+    } else {
+        println!("PROJECT ID\tSTATUS\tPACKAGES\tTARGET\tPROJECT");
+        print_managed_library_row(&status);
+        for diagnostic in &status.diagnostics {
+            println!("diagnostic={}\t{}", diagnostic.code, diagnostic.message);
+        }
+    }
+    Ok(status.state == ManagedLibraryStateV1::Healthy)
+}
+
+fn manage_add(repository: &Path, project: &Path, target: &str) -> Result<bool, String> {
+    let repository = validate_doctor(repository)?;
+    let plan = prepare_managed_intake_v1(
+        &repository,
+        project,
+        target,
+        ManagedIntakePolicyV1::UserSelectedLocal,
+    )
+    .map_err(managed_error)?;
+    println!("managed-intake-plan=1");
+    println!("project-id={}", plan.project_id);
+    println!("project={}", plan.project_root.display());
+    println!("target={}", plan.target);
+    println!("input-state={}", plan.input_state_name());
+    println!("project-tree-sha256={}", plan.project_tree_sha256);
+    println!("root-declaration-sha256={}", plan.root_declaration_sha256);
+    println!("direct-dependency-count={}", plan.direct_dependency_count);
+    println!("mutation={}", plan.mutation);
+    let executable = env::current_exe()
+        .map_err(|error| format!("cannot identify managed intake supervisor: {error}"))?;
+    let result = commit_managed_intake_v1(&plan, executable, "--explicit-managed-project")
+        .map_err(managed_error)?;
+    println!("managed-intake-status=healthy");
+    println!("active-generation={}", result.generation_sha256);
+    println!("package-count={}", result.package_count);
+    Ok(true)
+}
+
+fn print_managed_library_row(status: &ManagedLibraryStatusV1) {
+    let project_id = status
+        .project_id
+        .map_or_else(|| "-".to_owned(), |value| value.to_string());
+    let packages = status
+        .package_count
+        .map_or_else(|| "-".to_owned(), |value| value.to_string());
+    let target = status.target.as_deref().unwrap_or("-");
+    let project = status
+        .project_root
+        .as_ref()
+        .map_or_else(|| "-".to_owned(), |value| value.display().to_string());
+    println!(
+        "{project_id}\t{}\t{packages}\t{target}\t{project}",
+        status.state.as_str()
+    );
+}
