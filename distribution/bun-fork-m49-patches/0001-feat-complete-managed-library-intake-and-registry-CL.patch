+fn manage_command(mut arguments: impl Iterator<Item = std::ffi::OsString>) -> ExitCode {
+    let Some(action) = arguments.next() else {
+        return manage_usage_error("manage requires add, list, or status");
+    };
+    let Ok(action) = action.into_string() else {
+        return manage_usage_error("manage action is not UTF-8");
+    };
+    let result = match action.as_str() {
+        "list" => match manage_list_arguments(arguments) {
+            Ok((repository, json)) => manage_list(&repository, json),
+            Err(error) => return manage_usage_error(&error),
+        },
+        "status" => match manage_status_arguments(arguments) {
+            Ok((repository, query, json)) => manage_status(&repository, &query, json),
+            Err(error) => return manage_usage_error(&error),
+        },
+        "add" => match manage_add_arguments(arguments) {
+            Ok((repository, project, target)) => manage_add(&repository, &project, &target),
+            Err(error) => return manage_usage_error(&error),
+        },
+        _ => return manage_usage_error("manage requires add, list, or status"),
+    };
+    match result {
+        Ok(true) => ExitCode::SUCCESS,
+        Ok(false) => ExitCode::from(2),
+        Err(error) => {
+            eprintln!("leanbun: {error}");
+            ExitCode::from(1)
+        }
+    }
+}
+
+fn manage_usage_error(error: &str) -> ExitCode {
+    eprintln!("leanbun: {error}");
+    ExitCode::from(64)
+}
