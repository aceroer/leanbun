+#[cfg(test)]
+mod tests {
+    use super::{
+        manage_add_arguments, manage_command, manage_list_arguments, manage_status_arguments,
+    };
+    use std::ffi::OsString;
+    use std::path::PathBuf;
+
+    fn arguments(values: &[&str]) -> impl Iterator<Item = OsString> {
+        values
+            .iter()
+            .map(|value| OsString::from(*value))
+            .collect::<Vec<_>>()
+            .into_iter()
+    }
+
+    #[test]
+    fn manage_list_parser_accepts_only_the_optional_json_flag() {
+        assert_eq!(
+            manage_list_arguments(arguments(&["/repo", "--json"])),
+            Ok((PathBuf::from("/repo"), true))
+        );
+        assert!(manage_list_arguments(arguments(&["/repo", "--repair"])).is_err());
+        assert!(manage_list_arguments(arguments(&["/repo", "--json", "extra"])).is_err());
+    }
+
+    #[test]
+    fn manage_status_parser_requires_exact_query_shape() {
+        assert_eq!(
+            manage_status_arguments(arguments(&["/repo", "project-id", "--json"])),
+            Ok((PathBuf::from("/repo"), PathBuf::from("project-id"), true))
+        );
+        assert!(manage_status_arguments(arguments(&["/repo"])).is_err());
+        assert!(manage_status_arguments(arguments(&["/repo", "project-id", "--repair"])).is_err());
+    }
+
+    #[test]
+    fn manage_add_parser_requires_target_and_exact_confirmation() {
+        assert_eq!(
+            manage_add_arguments(arguments(&[
+                "/repo",
+                "/project",
+                "--target=Main",
+                "--explicit-managed-project",
+            ])),
+            Ok((
+                PathBuf::from("/repo"),
+                PathBuf::from("/project"),
+                "Main".to_owned(),
+            ))
+        );
+        assert!(
+            manage_add_arguments(arguments(&[
+                "/repo",
+                "/project",
+                "Main",
+                "--explicit-managed-project",
+            ]))
+            .is_err()
+        );
+        assert!(
+            manage_add_arguments(arguments(&[
+                "/repo",
+                "/project",
+                "--target=Main",
+                "--wrong-confirmation",
+            ]))
+            .is_err()
+        );
+    }
+
+    #[test]
+    fn manage_usage_errors_have_distinct_exit_code() {
+        assert_eq!(
+            manage_command(arguments(&[])),
+            std::process::ExitCode::from(64)
+        );
+        assert_eq!(
+            manage_command(arguments(&["list"])),
+            std::process::ExitCode::from(64)
+        );
+        assert_eq!(
+            manage_command(arguments(&["add"])),
+            std::process::ExitCode::from(64)
+        );
+    }
