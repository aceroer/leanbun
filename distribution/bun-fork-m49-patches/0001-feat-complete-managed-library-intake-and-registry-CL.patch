+fn manage_list_arguments(
+    mut arguments: impl Iterator<Item = std::ffi::OsString>,
+) -> Result<(PathBuf, bool), String> {
+    let repository = arguments
+        .next()
+        .ok_or_else(|| "manage list requires one repository path".to_owned())?;
+    let json = match arguments.next() {
+        None => false,
+        Some(option) if option == OsStr::new("--json") => true,
+        Some(_) => return Err("manage list accepts only an optional --json flag".to_owned()),
+    };
+    if arguments.next().is_some() {
+        return Err("manage list accepts one repository path and optional --json".to_owned());
+    }
+    Ok((PathBuf::from(repository), json))
+}
+
+fn manage_status_arguments(
+    mut arguments: impl Iterator<Item = std::ffi::OsString>,
+) -> Result<(PathBuf, PathBuf, bool), String> {
+    let repository = arguments.next().ok_or_else(|| {
+        "manage status requires repository and project path or ProjectId".to_owned()
+    })?;
+    let query = arguments.next().ok_or_else(|| {
+        "manage status requires repository and project path or ProjectId".to_owned()
+    })?;
+    let json = match arguments.next() {
+        None => false,
+        Some(option) if option == OsStr::new("--json") => true,
+        Some(_) => return Err("manage status accepts only an optional --json flag".to_owned()),
+    };
+    if arguments.next().is_some() {
+        return Err(
+            "manage status accepts repository, project path or ProjectId, and optional --json"
+                .to_owned(),
+        );
+    }
+    Ok((PathBuf::from(repository), PathBuf::from(query), json))
+}
+
+fn manage_add_arguments(
+    mut arguments: impl Iterator<Item = std::ffi::OsString>,
+) -> Result<(PathBuf, PathBuf, String), String> {
+    let repository = arguments.next().ok_or_else(|| {
+        "manage add requires repository, project, --target=NAME, and exact confirmation".to_owned()
+    })?;
+    let project = arguments.next().ok_or_else(|| {
+        "manage add requires repository, project, --target=NAME, and exact confirmation".to_owned()
+    })?;
+    let target = arguments.next().ok_or_else(|| {
+        "manage add requires repository, project, --target=NAME, and exact confirmation".to_owned()
+    })?;
+    let confirmation = arguments.next().ok_or_else(|| {
+        "manage add requires repository, project, --target=NAME, and exact confirmation".to_owned()
+    })?;
+    if arguments.next().is_some() || confirmation != OsStr::new("--explicit-managed-project") {
+        return Err(
+            "manage add requires the exact --explicit-managed-project confirmation".to_owned(),
+        );
+    }
+    let target = target
+        .into_string()
+        .map_err(|_| "managed target option is not UTF-8".to_owned())?
+        .strip_prefix("--target=")
+        .filter(|target| !target.is_empty())
+        .ok_or_else(|| "manage add requires a nonempty --target=NAME option".to_owned())?
+        .to_owned();
+    Ok((PathBuf::from(repository), PathBuf::from(project), target))
+}
