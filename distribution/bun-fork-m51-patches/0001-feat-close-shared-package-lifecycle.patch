+        "yes"
+    } else {
+        "no"
+    };
     let project = status
         .project_root
         .as_ref()
         .map_or_else(|| "-".to_owned(), |value| value.display().to_string());
     println!(
-        "{project_id}\t{}\t{packages}\t{target}\t{project}",
+        "{project_id}\t{}\t{packages}\t{sources}\t{builds}\t{hits}\t{rollback}\t{target}\t{project}",
