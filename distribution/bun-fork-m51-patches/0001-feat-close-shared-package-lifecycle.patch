+    let sources = status
+        .source_reference_count
+        .map_or_else(|| "-".to_owned(), |value| value.to_string());
+    let builds = status
+        .artifact_reference_count
+        .map_or_else(|| "-".to_owned(), |value| value.to_string());
+    let hits = status
+        .artifact_cache_hits
