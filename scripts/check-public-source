#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$REPOSITORY"

PROTECTED_M42="RUST_CONCURRENT_HISTORY_REGRESSION_M42.adoc"
PROTECTED_M42_SHA256="1b149ef4f5de5cc70d105671650f68fbe4b6fdf5e98fb25709c6e1b3b4bdbe3b"
ACTUAL_PROTECTED_SHA256=$(shasum -a 256 "$PROTECTED_M42" | awk '{print $1}')
if [ "$ACTUAL_PROTECTED_SHA256" != "$PROTECTED_M42_SHA256" ]; then
  echo "protected public M42 disclosure changed" >&2
  exit 1
fi

USER_ROOT='/'Users'/'
VOLUME_ROOT='/'Volumes'/'
if git grep -n -F -e "$USER_ROOT" -e "$VOLUME_ROOT" -- .; then
  echo "public source contains a personal absolute path" >&2
  exit 1
fi
UNAPPROVED_HISTORY_EMAILS=$(git log HEAD --format='%ae%n%ce' | sort -u | \
  grep -Ev '^(278689273\+aceroer@users\.noreply\.github\.com|leanbun-contributors@users\.noreply\.github\.com)$' || true)
if [ -n "$UNAPPROVED_HISTORY_EMAILS" ]; then
  echo "public branch history contains an unapproved author or committer email" >&2
  echo "$UNAPPROVED_HISTORY_EMAILS" >&2
  exit 1
fi
if git ls-files --error-unmatch config/leanbun-local-provider.json >/dev/null 2>&1; then
  echo "local provider configuration is tracked" >&2
  exit 1
fi
if ! git check-ignore -q config/leanbun-local-provider.json; then
  echo "local provider configuration is not ignored" >&2
  exit 1
fi

M48_PATCH_COUNT=$(find distribution/bun-fork-patches -type f -name '*.patch' | wc -l | tr -d ' ')
if [ "$M48_PATCH_COUNT" != "7" ]; then
  echo "Bun fork patch series must contain exactly seven patches" >&2
  exit 1
fi
M49_PATCH_COUNT=$(find distribution/bun-fork-m49-patches -type f -name '*.patch' | wc -l | tr -d ' ')
if [ "$M49_PATCH_COUNT" != "1" ]; then
  echo "M49 Bun fork incremental patch series must contain exactly one patch" >&2
  exit 1
fi
M50_PATCH_COUNT=$(find distribution/bun-fork-m50-patches -type f -name '*.patch' | wc -l | tr -d ' ')
if [ "$M50_PATCH_COUNT" != "2" ]; then
  echo "M50 Bun fork incremental patch series must contain exactly two patches" >&2
  exit 1
fi
M51_PATCH_COUNT=$(find distribution/bun-fork-m51-patches -type f -name '*.patch' | wc -l | tr -d ' ')
if [ "$M51_PATCH_COUNT" != "1" ]; then
  echo "M51 Bun fork incremental patch series must contain exactly one patch" >&2
  exit 1
fi
if grep -R -n -F -e "$USER_ROOT" -e "$VOLUME_ROOT" \
  distribution/bun-fork-patches distribution/bun-fork-m49-patches \
  distribution/bun-fork-m50-patches distribution/bun-fork-m51-patches; then
  echo "Bun fork patch series contains a personal absolute path" >&2
  exit 1
fi
if grep -R -h '^From:' \
  distribution/bun-fork-patches distribution/bun-fork-m49-patches \
  distribution/bun-fork-m50-patches distribution/bun-fork-m51-patches | \
  grep -Ev '^From: LeanBun contributors <noreply@invalid>$'; then
  echo "Bun fork patch series contains an unapproved author identity" >&2
  exit 1
fi

./scripts/check-crate-layering
./scripts/check-docs
echo "public-source=passed history-identities=noreply-only protected-m42-disclosure=redacted-and-bound m48-patch-count=$M48_PATCH_COUNT m49-patch-count=$M49_PATCH_COUNT m50-patch-count=$M50_PATCH_COUNT m51-patch-count=$M51_PATCH_COUNT"
